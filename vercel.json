{
  "version": 2,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "saulspodship.com"
        }
      ],
      "destination": "https://www.saulspodship.com/:path*",
      "permanent": true
    },
    {
      "source": "/music-archive/christians-of-pakistan-music-directory",
      "destination": "/Pakistanisingersarchive",
      "permanent": true
    },
    {
      "source": "/music-archive/pakistani-christian-gospel-singers-group",
      "destination": "/Pakistanisingersarchive",
      "permanent": true
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "api/**,firebase-applet-config.json,public/singers.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?originalPath=/api/$1"
    },
    {
      "source": "/encyclopedia/(.*)",
      "destination": "/api?originalPath=/encyclopedia/$1"
    },
    {
      "source": "/music-archive/(.*)",
      "destination": "/api?originalPath=/music-archive/$1"
    },
    {
      "source": "/Pakistanisingersarchive",
      "destination": "/api?originalPath=/Pakistanisingersarchive"
    },
    {
      "source": "/((?!assets/|images/|src/|dist/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)-[A-Za-z0-9_-]{8}\\.(js|css|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(images|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(chrome|site-header|seo-aeo|companion|maps-atlas|prophecy-lens)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/((?!assets/|images/|icons/|.*\\.[A-Za-z0-9]+$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
