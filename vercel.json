{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "api/data.ts,firebase-applet-config.json"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?originalPath=/api/$1" },
    { "source": "/encyclopedia/(.*)", "destination": "/api?originalPath=/encyclopedia/$1" },
    { "source": "/music-archive/(.*)", "destination": "/api?originalPath=/music-archive/$1" },
    { "source": "/Pakistanisingersarchive", "destination": "/api?originalPath=/Pakistanisingersarchive" },
    { "source": "/sitemap.xml", "destination": "/api?originalPath=/sitemap.xml" },
    { "source": "/((?!assets/|images/|src/|dist/).*)", "destination": "/index.html" }
  ]
}
