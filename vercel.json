{
  "version": 2,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "saulspodship.com"
        }
      ],
      "destination": "https://www.saulspodship.com/:path*",
      "permanent": true
    },
    {
      "source": "/music-archive/christians-of-pakistan-music-directory",
      "destination": "/Pakistanisingersarchive",
      "permanent": true
    },
    {
      "source": "/music-archive/pakistani-christian-gospel-singers-group",
      "destination": "/Pakistanisingersarchive",
      "permanent": true
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "api/**,firebase-applet-config.json,public/singers.html"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?originalPath=/api/$1" },
    { "source": "/encyclopedia/(.*)", "destination": "/api?originalPath=/encyclopedia/$1" },
    { "source": "/music-archive/(.*)", "destination": "/api?originalPath=/music-archive/$1" },
    { "source": "/Pakistanisingersarchive", "destination": "/api?originalPath=/Pakistanisingersarchive" },
    { "source": "/sitemap.xml", "destination": "/api?originalPath=/sitemap.xml" },
    { "source": "/((?!assets/|images/|src/|dist/).*)", "destination": "/index.html" }
  ]
}

